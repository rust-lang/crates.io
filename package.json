{
  "name": "crates-io",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://github.com/rust-lang/crates.io#readme",
  "bugs": {
    "url": "https://github.com/rust-lang/crates.io/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rust-lang/crates.io.git"
  },
  "license": "(MIT OR Apache-2.0)",
  "author": "",
  "scripts": {
    "build": "echo 'no-op build script kept for the heroku-buildpack-crates-io build step'",
    "lint:js": "eslint . --cache",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "e2e:svelte": "TEST_APP=svelte playwright test"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 1 Firefox version",
    "Firefox ESR",
    "last 1 Safari version",
    "last 1 iOS version",
    "last 1 Edge version",
    "last 1 UCAndroid version",
    "last 1 years"
  ],
  "dependencies": {
    "date-fns": "4.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@crates-io/msw": "workspace:*",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@msw/playwright": "0.7.0",
    "@percy/cli": "1.32.12",
    "@percy/playwright": "1.1.2",
    "@playwright/test": "1.65.1",
    "@sinonjs/fake-timers": "15.5.0",
    "@sveltejs/load-config": "0.2.3",
    "@types/node": "26.6.7",
    "@types/sinonjs__fake-timers": "15.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prefer-let": "4.2.2",
    "eslint-plugin-storybook": "10.6.9",
    "eslint-plugin-svelte": "3.24.1",
    "eslint-plugin-unicorn": "80.0.0",
    "globals": "17.14.0",
    "msw": "3.0.7",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  }
}
